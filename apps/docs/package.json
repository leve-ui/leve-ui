    "@fontsource/roboto-mono": "^5.3.0",
    "@leve-ui/accordion": "workspace:*",
    "@leve-ui/alert": "workspace:*",
    "@leve-ui/avatar": "workspace:*",
    "@leve-ui/breadcrumb": "workspace:*",
    "@leve-ui/checkbox": "workspace:*",
    "@leve-ui/collapsible": "workspace:*",
    "@leve-ui/core": "workspace:*",
    "@leve-ui/field": "workspace:*",
    "@leve-ui/fieldset": "workspace:*",
    "@leve-ui/label": "workspace:*",
    "@leve-ui/meter": "workspace:*",
    "@leve-ui/progress": "workspace:*",
    "@leve-ui/radio-group": "workspace:*",
    "@leve-ui/separator": "workspace:*",

{
  "name": "@leve-ui/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "props": "node scripts/generate-props.ts",
    "i18n": "node scripts/i18n/generate.ts",
    "dev": "pnpm props && pnpm i18n && panda codegen && vite --mode ssr",
    "build": "pnpm props && pnpm i18n && panda codegen && qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --noEmit",
    "typecheck": "pnpm props && pnpm i18n && panda codegen && tsc --noEmit",
    "preview": "qwik build preview && vite preview",
    "qwik": "qwik",
    "test": "node --test scripts/"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.4",
    "@builder.io/qwik-city": "1.20.4",

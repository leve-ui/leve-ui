{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.tsx",
        "!**/*.test.ts",
        "$TURBO_ROOT$/apps/storybook/stories/demos/**"
      ]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/storybook/stories/demos/**"]
    }
  }
}

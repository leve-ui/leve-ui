{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/lib",
      "!**/lib-types",
      "!**/dist",
      "!**/server",
      "!**/storybook-static",
      "!**/styled-system",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.turbo",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "tooling/**",
        "**/*.config.ts",
        "**/.storybook/**",
        "apps/e2e/**",
        "apps/docs/scripts/**"
      ],
      "linter": {
        "domains": {
          "qwik": "none"
        }
      }
    },
    {
      "includes": ["**/*.svg"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [".github/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    }
  ]
}

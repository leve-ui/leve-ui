{
  "name": "@leve-ui/accordion",
  "version": "0.0.0",
  "description": "Headless, WAI-ARIA compliant Accordion component for Qwik. Bring your own styles.",
  "homepage": "https://github.com/leve-ui/leve-ui#readme",
  "bugs": {
    "url": "https://github.com/leve-ui/leve-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leve-ui/leve-ui.git",
    "directory": "packages/components/accordion"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.qwik.cjs",
  "module": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "@leve-ui/source": "./src/index.ts",
      "types": "./lib-types/index.d.ts",
      "import": "./lib/index.qwik.mjs",
      "require": "./lib/index.qwik.cjs"
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "keywords": [
    "qwik",
    "headless-ui",
    "accessibility",
    "wai-aria",
    "accordion"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm build:types",
    "build:lib": "vite build --mode lib",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@leve-ui/utils": "workspace:*"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.20.4"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.4",
    "@leve-ui/tsconfig": "workspace:*",
    "@leve-ui/vite-config": "workspace:*",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
